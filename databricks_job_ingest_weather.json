{
  "name": "weather-ingest-job",
  "tasks": [
    {
      "task_key": "ingest_weather_task",
      "description": "Run the ingestion script to fetch NWS alerts and write embeddings",
      "spark_python_task": {
        "python_file": "dbfs:/FileStore/repos/your-repo/scripts/ingest_weather_embeddings.py",
        "parameters": ["--states", "CA,TX", "--model", "sentence-transformers/all-MiniLM-L6-v2"]
      },
      "new_cluster": {
        "spark_version": "14.1.x-scala2.12",
        "node_type_id": "Standard_D3_v2",
        "num_workers": 1,
        "custom_tags": {"project": "weather-rag"}
      }
    }
  ],
  "email_notifications": {},
  "timeout_seconds": 0,
  "max_concurrent_runs": 1
}
